---
import Layout from "../../layouts/Layout.astro";
import PRODUCTS from "../../data/products";

export function getStaticPaths() {
    return PRODUCTS.map((p) => ({ params: { product: p.slug } }));
}

const { product: slug } = Astro.params;
const product = PRODUCTS.find((p) => p.slug === slug);

if (!product) {
    return Astro.redirect("/404");
}
---

<Layout>
    <div class="grid grid-cols-12 gap-8">
        <div class="col-span-5">
            <img
                src={product.thumbnail}
                class="object-contain bg-white w-full h-[60vh] rounded-xl border border-neutral-200 mb-2"
            />
        </div>
        <div class="col-span-7 flex flex-col gap-4">
            <div>
                <a href="/category">
                    {product.category}
                </a>
            </div>
            <h2 class="font-bold text-4xl mb-2">{product.title}</h2>
            <p>
                {product.description}
            </p>
            <div class="flex justify-between items-center mt-auto">
                <div class="font-bold text-xl">{product.price} ریال</div>

                <div class="flex gap-2">
                    <input
                        value="1"
                        type="number"
                        class="bg-white rounded-xl border border-neutral-200 w-16 ps-4 pe-2"
                    />
                    <button
                        class="bg-green-800 text-white rounded-xl py-4 px-8"
                    >
                        افزودن به سبد خرید
                    </button>
                </div>
            </div>
        </div>
    </div>
</Layout>
