---
import Layout from "../../layouts/Layout.astro";
import Input from "../../components/ui/input.astro";
import Button from "../../components/ui/button.astro";
---

<Layout>
    <div class="bg-white border border-neutral-200 p-4 rounded-xl w-[90%] md:w-2/3 lg:w-1/3 mx-auto">
        <div class="font-bold text-xl text-center">ثبت نام</div>
        <div class="flex flex-col gap-2 my-8">
            <Input label="آدرس ایمیل" />
            <Input label="رمز ورود" type="password" />
            <Input label="تایید رمز ورود" type="password" />
        </div>
        <div class="flex items-center justify-between">
            <div class="text-neutral-500 mt-2 text-center">
                <span>قبلا ثبت نام کرده اید؟</span>
                <a href="/auth/sign-up">ورود</a>
            </div>
            <Button>ثبت نام</Button>
        </div>
    </div>
</Layout>
