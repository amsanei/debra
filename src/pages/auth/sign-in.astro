---
import  Layout  from "../../layouts/Layout.astro";
import  Input  from "../../components/ui/input.astro";
import  Button  from "../../components/ui/button.astro";
---

<Layout>
    <div class="bg-white border border-neutral-200 p-4 rounded-xl w-[90%] md:w-2/3 lg:w-1/3 mx-auto">
        <div class="font-bold text-xl text-center">
            ورود به حساب کاربری
        </div>
        <div class="flex flex-col gap-2 my-8">
            <Input label="آدرس ایمیل" />
            <Input label="رمز ورود" type="password" />
        </div>
        <div class="flex items-center justify-between">
            <div class="text-neutral-500">رمز عبور خود را فراموش کرده اید؟
                <a href="/auth/reset-password">فراموشی رمز عبور</a>
            </div>
            <Button>
            ورود
        </Button>
        </div>
    </div>
     <div class="text-neutral-500 mt-2 text-center">
        <span>حساب کاربری ندارید؟</span>
        <a href="/auth/sign-up">ثبت نام</a>
    </div>
    </Layout>
