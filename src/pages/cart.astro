---
import CartItem from "../components/CartItem.astro";
import PRODUCTS from "../data/products";
import Layout from "../layouts/Layout.astro";
---

<Layout>
    <div>
        <div class="font-bold text-xl mb-2">سبد خرید</div>
        <div class="grid grid-cols-12 gap-4 items-start">
            <div
                class="bg-white border border-neutral-200 p-4 rounded-xl col-span-8 flex flex-col gap-4"
            >
                {
                    PRODUCTS.slice(-2).map((item, index) => (
                        <CartItem data={item} isLast={index === 1} />
                    ))
                }
            </div>
            <div class="bg-[#20302b] text-white col-span-4 rounded-xl p-8">
                <div class="font-bold mb-4">خلاصه سفارش</div>
                <div class="space-y-2 border-b pb-4 border-white/10">
                    <div class="flex justify-between items-center">
                        <div class="opacity-60">مجموع</div>
                        <div>۲۰۰‍‍،۰۰۰</div>
                    </div>
                    <div class="flex justify-between items-center">
                        <div class="opacity-60">ارسال</div>
                        <div>۸۰‍‍،۰۰۰</div>
                    </div>
                </div>
                <div class="flex justify-between items-center mt-4 font-bold">
                    <div>قابل پرداخت</div>
                    <div>۲۸۰،۰۰۰</div>
                </div>
                <button
                    class="bg-green-200 w-full mt-4 py-2 px-4 text-green-800 font-bold rounded-xl"
                >
                    ادامه خرید
                </button>
            </div>
        </div>
    </div>
</Layout>
