---
import { Store, ShoppingBag, Search, User } from "@lucide/astro";
const LINKS = [
    { id: 0, title: "خانه", href: "/" },
    { id: 1, title: "فروشگاه", href: "/shop" },
    { id: 2, title: "درباره ما", href: "/about" },
    { id: 3, title: "حساب کاربری", href: "/auth" },
];
---

<header class="sticky top-0">
    <div
        class="flex justify-between py-4 px-8 items-center bg-white/70 backdrop-blur-2xl border-b border-neutral-200"
    >
        <div class="flex gap-6 items-center">
            <div class="flex gap-2 items-center">
                <div class="bg-green-800 p-2 rounded-lg text-white">
                    <Store stroke-width={1.8} size={22} />
                </div>
                <div class="text-lg font-bold">
                    <span>دبرا</span>
                    <span class="text-green-800 text-2xl">.</span>
                </div>
            </div>
            <div class="flex gap-4">
                {
                    LINKS.map((item) => (
                        <a
                            href={item.href}
                            class="block text-neutral-600 hover:text-green-800 font-bold"
                        >
                            {item.title}
                        </a>
                    ))
                }
            </div>
        </div>
        <div class="flex gap-1">
            <div
                class="bg-green-700/10 p-2 rounded-full text-green-800 cursor-pointer"
            >
                <ShoppingBag stroke-width={1.8} size={20} />
            </div>
            <div class="p-2 rounded-full text-green-800 cursor-pointer">
                <User stroke-width={1.8} size={20} />
            </div>
            <div class="p-2 rounded-full text-green-800 cursor-pointer">
                <Search stroke-width={1.8} size={20} />
            </div>
        </div>
    </div>
</header>
