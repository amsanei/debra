---
const { info } = Astro.props;
---

<div class="flex flex-col bg-white rounded-xl overflow-hidden">
    <div>
        <img src={info.thumbnail} />
    </div>
    <div class="p-2 flex flex-col gap-1">
        <div class="font-bold my-2">{info.title}</div>
        <div>{info.price}</div>
    </div>
</div>
