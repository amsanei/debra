---
import { ShoppingCartPlus } from "@lucide/astro";
const { info } = Astro.props;
---

<div
    class="flex flex-col bg-white rounded-xl overflow-hidden border border-neutral-200"
>
    <div class="border-b border-neutral-200">
        <img src={info.thumbnail} class="object-cover w-64 mx-auto" />
    </div>
    <div class="px-4 py-2 flex flex-col gap-1">
        <div class="font-bold mb-8">
            <a href={"shop/" + info.slug}> {info.title} </a>
        </div>
        <div class="flex justify-between items-center">
            <div>{info.price} ریال</div>
            <div>
                <button class="flex gap-1 items-center text-green-800">
                    <ShoppingCartPlus stroke-width={1.8} size={20} />
                    <div class="text-sm">افزودن به سبد خرید</div>
                </button>
            </div>
        </div>
    </div>
</div>
