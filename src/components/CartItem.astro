---
import { EllipsisVertical } from "@lucide/astro";

interface Props {
    data: {
        id: number;
        title: string;
        slug: string;
        price: string;
        category: string;
        description: string;
        thumbnail: string;
        images: string[];
    };
    isLast: boolean;
}

const { data, isLast } = Astro.props;
---

<div
    class={[
        "flex justify-between ",
        !isLast && "border-b border-neutral-200 pb-4",
    ].join(" ")}
>
    <div class="flex gap-2">
        <div
            class="size-24 border border-neutral-200 rounded-xl overflow-hidden"
        >
            <img src={data.thumbnail} alt={data.title} />
        </div>
        <div class="flex flex-col justify-between py-1">
            <div>
                <div class="font-bold">{data.title}</div>
                <div class="text-sm opacity-60">
                    {data.description}
                </div>
            </div>
            <div class="font-bold">
                {data.price} ریال
            </div>
        </div>
    </div>
    <div class="flex flex-col justify-between items-end py-1">
        <div>
            <EllipsisVertical font-size={22} stroke-width={1.8} />
        </div>
    </div>
</div>
